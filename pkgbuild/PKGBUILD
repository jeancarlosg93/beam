pkgname=beam
pkgver=0.2.0
pkgrel=1
pkgdesc='A playlist controller for fullscreen mpv projection on Omarchy'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-svg' 'mpv' 'xdg-desktop-portal' 'ffmpeg')
makedepends=('gcc' 'make')
source=()
sha256sums=()
build() {
  cd "$startdir/.."
  ./bin/build
}
package() {
  cd "$startdir/.."
  install -Dm755 build/beam "$pkgdir/usr/bin/beam"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/beam/LICENSE"
  install -Dm644 pkgbuild/beam.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/beam.svg"
  install -Dm644 pkgbuild/beam.desktop "$pkgdir/usr/share/applications/beam.desktop"
}
